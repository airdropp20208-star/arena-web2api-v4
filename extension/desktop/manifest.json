{
  "manifest_version": 3,
  "name": "Arena Token Broker Desktop",
  "version": "3.0.0",
  "description": "Desktop token broker for arena-web2api via HTTP polling.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena Token Broker Desktop",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
